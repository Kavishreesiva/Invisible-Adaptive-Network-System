# IANSA Backend Environment Configuration
# Copy to .env and fill in real values. Never commit secrets.

# Flask secret key (change in production)
SECRET_KEY=iansa-super-secret-key-change-in-production-2026

# JWT signing secret (must be >= 32 chars in production)
JWT_SECRET_KEY=iansa-jwt-secret-key-2026-adaptive-security

# Database URL (defaults to local SQLite file: database/iansa_security.db)
# DATABASE_URL=sqlite:////path/to/iansa_security.db

# Execution mode: SIMULATION (default) or LINUX_NATIVE
IANSA_EXECUTION_MODE=SIMULATION

# Path to Suricata eve.json for live IDS ingestion
SURICATA_LOG_PATH=/var/log/suricata/eve.json

# Backend port
PORT=5000
